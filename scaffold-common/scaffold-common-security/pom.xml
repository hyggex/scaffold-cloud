<?xml version="1.0" encoding="UTF-8"?>
<!-- scaffold-common-security：Sa-Token 认证鉴权公共配置 -->
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.scaffold</groupId>
        <artifactId>scaffold-common</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>scaffold-common-security</artifactId>
    <dependencies>
        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <!-- Sa-Token -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
        </dependency>
        <!-- Spring Security（密码编码器等） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- 核心模块 -->
        <dependency>
            <groupId>com.scaffold</groupId>
            <artifactId>scaffold-common-core</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>
</project>
