# ================================================================
# Scaffold 微服务脚手架 - 环境变量配置示例
# 复制此文件为 .env 后修改对应值即可运行
# ================================================================

# --------------- Nacos 配置中心 ---------------
NACOS_SERVER_ADDR=localhost:8848
NACOS_NAMESPACE=
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos

# --------------- MySQL 数据库 ---------------
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=scaffold
MYSQL_USER=root
MYSQL_PASSWORD=root123

# --------------- Redis 缓存 ---------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# --------------- MinIO 对象存储 ---------------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_BUCKET=scaffold
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=admin123

# --------------- Dubbo RPC ---------------
DUBBO_PREFERRED_NETWORKS=
